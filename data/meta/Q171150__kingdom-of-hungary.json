 "title": "Kingdom of Hungary",
 "variantOf": "Q171150",
 "endonym": {
  "native": "Magyar Királyság",
  "roman": "Magyar Királyság"
 },
 "capsule": "Founded when Stephen I was crowned with a diadem sent by Pope Sylvester II around Christmas 1000/January 1001, the Kingdom of Hungary (Magyar Királyság) Christianized the Magyar tribal confederation and, under the Árpád, Angevin, and Jagiellonian dynasties, grew into a major Central European power that at times held Croatia, Dalmatia, and parts of the Balkans. Ottoman victory at the Battle of Mohács in 1526, where King Louis II died, shattered royal authority, and by the 1541–1547 partition the medieval kingdom had split into Habsburg-ruled \"Royal Hungary,\" Ottoman Hungary, and the autonomous Principality of Transylvania.",
 "citations": [
  {
   "label": "Hungary - Britannica",
   "url": "https://www.britannica.com/place/Hungary"
  }
 ],
